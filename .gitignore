# dist/ 는 의도적으로 커밋한다.
# 대회장 PC에 Node 가 없어도 clone/복사만으로 dist/index.html 이 동작해야 한다.

node_modules/
.venv/
__pycache__/
*.pyc

# 루트의 요구사항/프롬프트/개발 문서는 로컬 전용이다.
# 실제 사전 원문인 content/articles/*.md 는 계속 추적한다.
/*.md
!/README.md

# 자격증명·키와 원본 포렌식 증거는 저장소 밖에 둔다.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.pcap
*.pcapng
*.cap
*.evtx

# 큰 바이너리는 Git history 에 넣지 않는다 (STORAGE_BUDGET.md).
# 증거물 샘플·툴 설치본·디스크/메모리 이미지는 repo 밖 별도 폴더에 둔다.
*.E01
*.e01
*.raw
*.mem
*.vmem
*.dmp
*.vhd
*.vhdx
*.vmdk
*.iso
*.aff4
hiberfil.sys
pagefile.sys
samples/
evidence/
toolkit/

# OS / 편집기
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/

# 임시 산출물
tmp/
out/
*.log.tmp
/state/progress.json
